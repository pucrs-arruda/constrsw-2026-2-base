{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constrsw.pucrs.br/schemas/grupo01-classes-schemas.json",
  "title": "Classes API (Grupo 01) — JSON Schemas",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador opaco UUID (contrato = string)."
    },
    "UuidArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Uuid"
      },
      "uniqueItems": true
    },
    "ClassStatus": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "description": "Estado da oferta da turma."
    },
    "OrdinalRating": {
      "type": "string",
      "enum": [
        "very_bad",
        "bad",
        "fair",
        "good",
        "very_good"
      ],
      "description": "Escala ordinal simétrica (5 tokens) persistida e devolvida pela API. Mapa interno 1..5 só para média."
    },
    "OrdinalRatingInput": {
      "type": "string",
      "enum": [
        "very_bad",
        "bad",
        "fair",
        "good",
        "very_good",
        "muito_ruim",
        "ruim",
        "regular",
        "bom",
        "muito_bom"
      ],
      "description": "Valor aceito na escrita. Aliases em português são normalizados para OrdinalRating antes de persistir."
    },
    "AverageRating": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 5,
      "multipleOf": 0.1,
      "description": "Média aritmética 1.0..5.0 com uma casa decimal; null se n=0. Campo calculado (não persistido)."
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "description": "Data do período da oferta (calendário), não horário do dia."
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "FilterOperatorValue": {
      "type": "string",
      "description": "Valor de filtro simples (`status=active`) ou com operador `{op}` prefixado: `{neq}active`, `{gt}20`, `{gteq}2026-01-01`, `{lt}2026-12-31`, `{lteq}2.5`, `{like}%algo%`. Sem `{op}` = equals."
    },
    "ProblemDetails": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "title",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri",
          "description": "URI que identifica o tipo do problema."
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string",
          "format": "uri-reference",
          "description": "Caminho da requisição (requestURI), não necessariamente URI absoluta."
        },
        "code": {
          "type": "string",
          "description": "Código estável alinhado ao FR do PRD quando aplicável (ex. FR-6)."
        }
      }
    },
    "ClassCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseId",
        "startDate",
        "endDate",
        "seats",
        "roomId",
        "professorIds"
      ],
      "properties": {
        "courseId": {
          "$ref": "#/$defs/Uuid"
        },
        "startDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "endDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "seats": {
          "type": "integer",
          "minimum": 1
        },
        "roomId": {
          "$ref": "#/$defs/Uuid"
        },
        "professorIds": {
          "allOf": [
            {
              "$ref": "#/$defs/UuidArray"
            }
          ],
          "minItems": 1
        },
        "studentIds": {
          "$ref": "#/$defs/UuidArray",
          "description": "Opcional. Omitido equivale a lista vazia."
        },
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 255
        },
        "status": {
          "$ref": "#/$defs/ClassStatus"
        },
        "modality": {
          "type": "string",
          "maxLength": 64
        }
      },
      "description": "Criação de Class. status default `active` e studentIds default [] se omitidos. professorIds não pode ser vazio. startDate ≤ endDate."
    },
    "ClassUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseId",
        "startDate",
        "endDate",
        "seats",
        "roomId",
        "professorIds",
        "status"
      ],
      "properties": {
        "courseId": {
          "$ref": "#/$defs/Uuid"
        },
        "startDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "endDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "seats": {
          "type": "integer",
          "minimum": 1
        },
        "roomId": {
          "$ref": "#/$defs/Uuid"
        },
        "professorIds": {
          "allOf": [
            {
              "$ref": "#/$defs/UuidArray"
            }
          ],
          "minItems": 1
        },
        "studentIds": {
          "$ref": "#/$defs/UuidArray",
          "description": "Opcional no PUT. Omitido equivale a lista vazia."
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "status": {
          "$ref": "#/$defs/ClassStatus"
        },
        "modality": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      },
      "description": "Substituição total (PUT). studentIds omitido vira []. courseId, startDate e endDate são imutáveis após a criação — alteração → 422."
    },
    "ClassPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "seats": {
          "type": "integer",
          "minimum": 1
        },
        "roomId": {
          "$ref": "#/$defs/Uuid"
        },
        "professorIds": {
          "allOf": [
            {
              "$ref": "#/$defs/UuidArray"
            }
          ],
          "minItems": 1
        },
        "studentIds": {
          "$ref": "#/$defs/UuidArray"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "status": {
          "$ref": "#/$defs/ClassStatus"
        },
        "modality": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      },
      "description": "Atualização parcial. Não inclui courseId, startDate nem endDate (imutáveis). professorIds, se enviado, não pode ser vazio."
    },
    "Class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "courseId",
        "startDate",
        "endDate",
        "seats",
        "roomId",
        "professorIds",
        "studentIds",
        "status",
        "averageRating"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "enabled": {
          "type": "boolean",
          "readOnly": true,
          "default": true,
          "description": "Exclusão lógica: true para registro ativo; false para registro excluído logicamente. Controlado pelo servidor."
        },
        "courseId": {
          "$ref": "#/$defs/Uuid"
        },
        "startDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "endDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "seats": {
          "type": "integer",
          "minimum": 1
        },
        "roomId": {
          "$ref": "#/$defs/Uuid"
        },
        "professorIds": {
          "allOf": [
            {
              "$ref": "#/$defs/UuidArray"
            }
          ],
          "minItems": 1
        },
        "studentIds": {
          "$ref": "#/$defs/UuidArray"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "status": {
          "$ref": "#/$defs/ClassStatus"
        },
        "modality": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "averageRating": {
          "$ref": "#/$defs/AverageRating"
        }
      },
      "description": "Leitura de Class. Não embute Avaliações. averageRating sempre presente (null se sem reviews)."
    },
    "ClassList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Class"
      },
      "description": "GET /v1/classes e POST /v1/classes/import devolvem um array JSON, sem envelope."
    },
    "ClassImportItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseId",
        "startDate",
        "endDate",
        "seats",
        "roomId",
        "professorIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid",
          "description": "Opcional. Omitido faz o servidor gerar o UUID."
        },
        "courseId": {
          "$ref": "#/$defs/Uuid"
        },
        "startDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "endDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "seats": {
          "type": "integer",
          "minimum": 1
        },
        "roomId": {
          "$ref": "#/$defs/Uuid"
        },
        "professorIds": {
          "allOf": [
            {
              "$ref": "#/$defs/UuidArray"
            }
          ],
          "minItems": 1
        },
        "studentIds": {
          "$ref": "#/$defs/UuidArray",
          "description": "Opcional. Omitido equivale a lista vazia."
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "status": {
          "$ref": "#/$defs/ClassStatus"
        },
        "modality": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      },
      "description": "Item de POST /v1/classes/import. status default `active` se omitido."
    },
    "ClassImport": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClassImportItem"
      },
      "description": "Corpo de POST /v1/classes/import. A resposta é ClassList."
    },
    "ReviewCreate": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "ordinalRating"
          ]
        },
        {
          "required": [
            "notaOrdinal"
          ]
        }
      ],
      "properties": {
        "ordinalRating": {
          "$ref": "#/$defs/OrdinalRatingInput"
        },
        "notaOrdinal": {
          "$ref": "#/$defs/OrdinalRatingInput",
          "description": "Alias de ordinalRating. Se ambos vierem, ordinalRating prevalece."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "Texto opcional. Ausente, vazio ou null é aceito."
        },
        "texto": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "Alias de text. Se ambos vierem, text prevalece."
        }
      },
      "description": "Criação de Avaliação. autorId vem do token + roster (nunca no body). A resposta usa ordinalRating e text."
    },
    "ReviewUpdate": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "ordinalRating"
          ]
        },
        {
          "required": [
            "notaOrdinal"
          ]
        }
      ],
      "properties": {
        "ordinalRating": {
          "$ref": "#/$defs/OrdinalRatingInput"
        },
        "notaOrdinal": {
          "$ref": "#/$defs/OrdinalRatingInput",
          "description": "Alias de ordinalRating. Se ambos vierem, ordinalRating prevalece."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "texto": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "Alias de text. Se ambos vierem, text prevalece."
        }
      },
      "description": "Substituição total (PUT) pelo próprio autor."
    },
    "ReviewPatch": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1,
      "properties": {
        "ordinalRating": {
          "$ref": "#/$defs/OrdinalRatingInput"
        },
        "notaOrdinal": {
          "$ref": "#/$defs/OrdinalRatingInput",
          "description": "Alias de ordinalRating. Se ambos vierem, ordinalRating prevalece."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "texto": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "Alias de text. Null explícito em text ou texto apaga o texto."
        }
      },
      "description": "Atualização parcial pelo próprio autor. Campos desconhecidos são ignorados. Exige ao menos ordinalRating, notaOrdinal, text ou texto."
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "classId",
        "ordinalRating",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "enabled": {
          "type": "boolean",
          "readOnly": true,
          "default": true,
          "description": "Exclusão lógica: true para registro ativo; false para registro excluído logicamente. Controlado pelo servidor."
        },
        "classId": {
          "$ref": "#/$defs/Uuid"
        },
        "ordinalRating": {
          "$ref": "#/$defs/OrdinalRating"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "createdAt": {
          "$ref": "#/$defs/IsoDateTime"
        }
      },
      "description": "Leitura pública de Avaliação. Sem autorId e sem papel do autor."
    },
    "ReviewList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Review"
      },
      "description": "GET /v1/classes/{classId}/reviews devolve um array JSON. A média fica em Class.averageRating, não neste corpo."
    }
  }
}
