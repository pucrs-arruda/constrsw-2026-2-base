{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constrsw.pucrs.br/schemas/grupo06-resources-schemas.json",
  "title": "Resources API (Grupo 06) — JSON Schemas",
  "$defs": {
    "ResourceType": {
      "type": "string",
      "enum": [
        "PROJECTOR",
        "HEALTH_KIT",
        "COMPUTER",
        "NOTEBOOK",
        "CAMERA",
        "MICROPHONE",
        "DISPLAY",
        "CABLE",
        "ADAPTER"
      ],
      "description": "Resource kind. Descriptive only; active is the reservation gate. ROOM is not a resource type and there is no OTHER fallback.\n"
    },
    "OccurrenceType": {
      "type": "string",
      "enum": [
        "MALFUNCTION",
        "DAMAGE",
        "MISSING",
        "OTHER"
      ]
    },
    "OccurrencePriority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "OccurrenceStatus": {
      "type": "string",
      "enum": [
        "OPEN",
        "RESOLVED"
      ]
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "type",
        "active",
        "enabled",
        "tags",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "$ref": "#/$defs/ResourceType"
        },
        "active": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean",
          "description": "Logical-deletion flag; false means the row is hidden from the API."
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ResourceCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "type"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$",
          "description": "Trimmed and uppercased before storage."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "$ref": "#/$defs/ResourceType"
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 30
          }
        }
      }
    },
    "ResourcePut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "type"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$",
          "description": "Must equal the stored code; code is immutable."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "$ref": "#/$defs/ResourceType"
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "default": [],
          "items": {
            "type": "string",
            "maxLength": 30
          }
        }
      }
    },
    "ResourcePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "$ref": "#/$defs/ResourceType"
        },
        "active": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 30
          }
        }
      }
    },
    "Occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resourceId",
        "description",
        "type",
        "priority",
        "status",
        "enabled",
        "resolution",
        "reportedBy",
        "resolvedBy",
        "createdAt",
        "resolvedAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "resourceId": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/OccurrenceType"
        },
        "priority": {
          "$ref": "#/$defs/OccurrencePriority"
        },
        "status": {
          "$ref": "#/$defs/OccurrenceStatus"
        },
        "enabled": {
          "type": "boolean",
          "description": "Logical-deletion flag; false means the row is hidden from the API."
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "reportedBy": {
          "type": "string",
          "format": "uuid"
        },
        "resolvedBy": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OccurrenceCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "type"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/OccurrenceType"
        },
        "priority": {
          "$ref": "#/$defs/OccurrencePriority",
          "default": "MEDIUM"
        }
      }
    },
    "OccurrencePut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "type"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/OccurrenceType"
        },
        "priority": {
          "$ref": "#/$defs/OccurrencePriority",
          "default": "MEDIUM"
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "description": "Supplying resolution resolves the occurrence."
        }
      }
    },
    "OccurrencePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/OccurrenceType"
        },
        "priority": {
          "$ref": "#/$defs/OccurrencePriority"
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "description": "Supplying resolution resolves the occurrence."
        }
      }
    },
    "ResourceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Resource"
      }
    },
    "OccurrenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Occurrence"
      }
    },
    "ResourceAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "type",
        "active",
        "enabled",
        "tags",
        "createdAt",
        "updatedAt",
        "occurrences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "$ref": "#/$defs/ResourceType"
        },
        "active": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean",
          "description": "Logical-deletion flag; false means the row is hidden from the API."
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "occurrences": {
          "$ref": "#/$defs/OccurrenceList"
        }
      }
    },
    "FieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "code",
        "instance"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        }
      }
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "service",
        "database"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "service": {
          "type": "string",
          "const": "resources"
        },
        "database": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        }
      }
    },
    "Live": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "service"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "service": {
          "type": "string",
          "const": "resources"
        }
      }
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "service",
        "database",
        "identity"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "service": {
          "type": "string",
          "const": "resources"
        },
        "database": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "identity": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "skipped"
          ]
        }
      }
    }
  }
}
