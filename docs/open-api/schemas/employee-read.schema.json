{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmployeeRead",
  "description": "Employee devolvido por GET /api/v1/employees e GET /api/v1/employees/{id}. Inclui ativo e os dependents ainda visíveis (enabled=true), cada um também com ativo. phone e email só aparecem quando estão gravados. enabled não aparece. Employee com enabled=false não entra na lista nem neste GET.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "registrationNumber",
    "name",
    "salary",
    "hireDate",
    "position",
    "status",
    "ativo",
    "dependents"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true,
      "description": "UUID v4 emitido pelo serviço. Imutável."
    },
    "registrationNumber": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Matrícula interna. Não é única."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "salary": {
      "type": "number"
    },
    "hireDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Data de admissão gravada, AAAA-MM-DD."
    },
    "position": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "phone": {
      "type": "string",
      "minLength": 1,
      "description": "Omitido quando não há telefone gravado."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Omitido quando não há e-mail gravado."
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Inactive"],
      "description": "Situação cadastral. Inactive continua neste GET."
    },
    "ativo": {
      "type": "boolean",
      "readOnly": true,
      "description": "true quando status é Active; false quando é Inactive. Calculado na leitura. Não entra no POST, PUT nem PATCH."
    },
    "dependents": {
      "type": "array",
      "description": "Dependentes ainda visíveis. Lista vazia quando não há nenhum. Itens excluídos logicamente ficam de fora.",
      "items": {
        "$ref": "./dependent-read.schema.json"
      }
    }
  },
  "examples": [
    {
      "id": "6f1c2b9e-8d4a-4c3e-9b1a-2f5d7e8c9a01",
      "registrationNumber": "100",
      "name": "Helena Costa",
      "salary": 8500.5,
      "hireDate": "2020-01-15",
      "position": "Analista",
      "phone": "5133203500",
      "email": "helena.costa@pucrs.br",
      "status": "Inactive",
      "ativo": false,
      "dependents": [
        {
          "id": "7a2d3c4e-1b5f-4a6c-8d9e-0f1a2b3c4d5e",
          "name": "Caio Costa",
          "birthDate": "2010-05-01",
          "dependencyType": "filho",
          "status": "Active",
          "ativo": true
        }
      ]
    }
  ]
}
