{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmployeeCreated",
  "description": "Resposta 201 de POST /api/v1/employees. Não traz ativo nem dependents. phone e email só aparecem quando foram gravados. enabled não aparece.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "registrationNumber",
    "name",
    "salary",
    "hireDate",
    "position",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true,
      "description": "UUID v4 emitido pelo serviço. Imutável."
    },
    "registrationNumber": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "salary": {
      "type": "number"
    },
    "hireDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Data de admissão gravada, AAAA-MM-DD."
    },
    "position": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "phone": {
      "type": "string",
      "minLength": 1,
      "description": "Omitido quando o telefone não foi gravado."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Omitido quando o e-mail não foi gravado."
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Inactive"]
    }
  },
  "examples": [
    {
      "id": "6f1c2b9e-8d4a-4c3e-9b1a-2f5d7e8c9a01",
      "registrationNumber": "100",
      "name": "Helena Costa",
      "salary": 8500.5,
      "hireDate": "2020-01-15",
      "position": "Analista",
      "status": "Active",
      "phone": "5133203500",
      "email": "helena.costa@pucrs.br"
    }
  ]
}
