      "description": "ok: 2xx. rejected: o Keycloak respondeu não-2xx (ex.: senha errada). unavailable: rede ou timeout, vira 503 no oauth.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (operation, result) (rate(oauth_keycloak_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "shades",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* unavailable$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "shades",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* rejected$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "shades",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
