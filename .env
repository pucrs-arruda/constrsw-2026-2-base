# Docker Compose
COMPOSE_PROJECT_NAME=constrsw

# Prometheus
PROMETHEUS_INTERNAL_HOST=prometheus
PROMETHEUS_INTERNAL_PORT=9090
PROMETHEUS_EXTERNAL_HOST=localhost
PROMETHEUS_EXTERNAL_PORT=9090

# Keycloak
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_MANAGEMENT_PORT=9001
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=a12345678
KEYCLOAK_REALM=constrsw
KEYCLOAK_CLIENT_ID=oauth
KEYCLOAK_CLIENT_SECRET=wsNXUxaupU9X6jCncsn3rOEy6PDt7oJO
KEYCLOAK_GRANT_TYPE=password
KEYCLOAK_TOKEN_ALGORITHM=RS256
KEYCLOAK_INTERNAL_PROTOCOL=http
KEYCLOAK_INTERNAL_HOST=keycloak
KEYCLOAK_INTERNAL_METRICS_PORT=9001
KEYCLOAK_INTERNAL_API_PORT=8080
KEYCLOAK_INTERNAL_CONSOLE_PORT=8080
KEYCLOAK_EXTERNAL_PROTOCOL=http
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_API_PORT=8081
KEYCLOAK_EXTERNAL_METRICS_PORT=9001
KEYCLOAK_EXTERNAL_CONSOLE_PORT=8081
KEYCLOAK_SERVER_URL=${KEYCLOAK_INTERNAL_PROTOCOL}://${KEYCLOAK_INTERNAL_HOST}:${KEYCLOAK_INTERNAL_API_PORT}
KEYCLOAK_JWKS_URL=${KEYCLOAK_SERVER_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
KEYCLOAK_ISSUER=${KEYCLOAK_SERVER_URL}/realms/${KEYCLOAK_REALM}
KEYCLOAK_ALLOWED_ISSUERS=${KEYCLOAK_ISSUER},${KEYCLOAK_EXTERNAL_PROTOCOL}://${KEYCLOAK_EXTERNAL_HOST}:${KEYCLOAK_EXTERNAL_API_PORT}/realms/${KEYCLOAK_REALM}
JWT_AUDIENCE=oauth

# oauth
OAUTH_INTERNAL_PROTOCOL=http
OAUTH_INTERNAL_HOST=oauth
OAUTH_INTERNAL_API_PORT=8088
OAUTH_INTERNAL_DEBUG_PORT=9464
OAUTH_INTERNAL_METRICS_PORT=8088
OAUTH_EXTERNAL_PROTOCOL=http
OAUTH_EXTERNAL_HOST=localhost
OAUTH_EXTERNAL_API_PORT=8181
OAUTH_EXTERNAL_DEBUG_PORT=8281
OAUTH_EXTERNAL_METRICS_PORT=8381
OAUTH_NODE_ENV=development
OAUTH_KEYCLOAK_TIMEOUT_MS=5000
OAUTH_KEYCLOAK_ADMIN_CLIENT_ID=oauth-admin
OAUTH_KEYCLOAK_ADMIN_CLIENT_SECRET=local-development-admin-secret
OAUTH_SESSION_COOKIE_NAME=closed_cras_session
OAUTH_COOKIE_SECURE=false
OAUTH_COOKIE_SAME_SITE=lax

# PostgreSQL
POSTGRESQL_INTERNAL_HOST=postgresql
POSTGRESQL_INTERNAL_PORT=5432
POSTGRESQL_EXTERNAL_HOST=localhost
POSTGRESQL_EXTERNAL_PORT=5432
