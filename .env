# bff
BFF_INTERNAL_PROTOCOL=http
BFF_INTERNAL_HOST=api
BFF_INTERNAL_API_PORT=3001
BFF_INTERNAL_DEBUG_PORT=9299
BFF_INTERNAL_METRICS_PORT=9464
BFF_EXTERNAL_PROTOCOL=http
BFF_EXTERNAL_HOST=localhost
BFF_EXTERNAL_API_PORT=8180
BFF_EXTERNAL_DEBUG_PORT=8280
BFF_EXTERNAL_METRICS_PORT=8380

BFF_APP_ENV=local
BFF_APP_VERSION=1.0.0
# Origem CORS do SPA (porta EXTERNAL do frontend). Literal: o bloco frontend vem depois neste arquivo.
BFF_ORIGIN=http://localhost:8080
BFF_SESSION_COOKIE_NAME=closed_cras_session
BFF_OAUTH_BASE_URL=${OAUTH_INTERNAL_PROTOCOL}://${OAUTH_INTERNAL_HOST}:${OAUTH_INTERNAL_API_PORT}
BFF_OAUTH_JWKS_PATH=/auth/jwks
BFF_OAUTH_VALIDATE_PATH=/auth/validate
BFF_JWT_ISSUER=${KEYCLOAK_ISSUER}
BFF_JWT_AUDIENCE=${JWT_AUDIENCE}
BFF_JWT_CLIENT_AUDIENCE=${KEYCLOAK_CLIENT_ID}
BFF_CLASSES_BASE_URL=${CLASSES_INTERNAL_PROTOCOL}://${CLASSES_INTERNAL_HOST}:${CLASSES_INTERNAL_API_PORT}
BFF_COURSES_BASE_URL=${COURSES_INTERNAL_PROTOCOL}://${COURSES_INTERNAL_HOST}:${COURSES_INTERNAL_API_PORT}
BFF_EMPLOYEES_BASE_URL=${EMPLOYEES_INTERNAL_PROTOCOL}://${EMPLOYEES_INTERNAL_HOST}:${EMPLOYEES_INTERNAL_API_PORT}
BFF_LESSONS_BASE_URL=${LESSONS_INTERNAL_PROTOCOL}://${LESSONS_INTERNAL_HOST}:${LESSONS_INTERNAL_API_PORT}
BFF_PROFESSORS_BASE_URL=${PROFESSORS_INTERNAL_PROTOCOL}://${PROFESSORS_INTERNAL_HOST}:${PROFESSORS_INTERNAL_API_PORT}
BFF_RESERVATIONS_BASE_URL=${RESERVATIONS_INTERNAL_PROTOCOL}://${RESERVATIONS_INTERNAL_HOST}:${RESERVATIONS_INTERNAL_API_PORT}
BFF_RESOURCES_BASE_URL=${RESOURCES_INTERNAL_PROTOCOL}://${RESOURCES_INTERNAL_HOST}:${RESOURCES_INTERNAL_API_PORT}
BFF_ROOMS_BASE_URL=${ROOMS_INTERNAL_PROTOCOL}://${ROOMS_INTERNAL_HOST}:${ROOMS_INTERNAL_API_PORT}
BFF_STUDENTS_BASE_URL=${STUDENTS_INTERNAL_PROTOCOL}://${STUDENTS_INTERNAL_HOST}:${STUDENTS_INTERNAL_API_PORT}
BFF_OTEL_SERVICE_NAME=bff-service
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_HTTP_PORT}/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_HTTP_PORT}/v1/traces
BFF_NODE_OPTIONS=--inspect=0.0.0.0:${BFF_INTERNAL_DEBUG_PORT}

# bff - resiliencia (HTTP e circuit breaker)
BFF_HTTP_TIMEOUT_MS=3000
BFF_HTTP_RETRIES=2
BFF_CIRCUIT_BREAKER_TIMEOUT_MS=3000
BFF_CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
BFF_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
BFF_CIRCUIT_BREAKER_VOLUME_THRESHOLD=10
BFF_CIRCUIT_BREAKER_ROLLING_WINDOW_MS=10000

# frontend
FRONTEND_INTERNAL_HOST=frontend
FRONTEND_INTERNAL_PORT=80
FRONTEND_EXTERNAL_HOST=localhost
FRONTEND_EXTERNAL_PORT=4200
