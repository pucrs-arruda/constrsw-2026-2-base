# Docker Compose
COMPOSE_PROJECT_NAME=constrsw

# Prometheus
PROMETHEUS_INTERNAL_HOST=prometheus
PROMETHEUS_INTERNAL_PORT=9090
PROMETHEUS_EXTERNAL_HOST=localhost
