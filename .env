KEYCLOAK_INTERNAL_CONSOLE_PORT=8080
KEYCLOAK_EXTERNAL_PROTOCOL=http
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_API_PORT=8180
KEYCLOAK_EXTERNAL_METRICS_PORT=9001
KEYCLOAK_EXTERNAL_CONSOLE_PORT=8180
KEYCLOAK_SERVER_URL=${KEYCLOAK_INTERNAL_PROTOCOL}://${KEYCLOAK_INTERNAL_HOST}:${KEYCLOAK_INTERNAL_API_PORT}

# oauth
