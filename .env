# Docker Compose
COMPOSE_PROJECT_NAME=constrsw

# Prometheus
PROMETHEUS_INTERNAL_HOST=prometheus
PROMETHEUS_INTERNAL_PORT=9090
PROMETHEUS_EXTERNAL_HOST=localhost
PROMETHEUS_EXTERNAL_PORT=9090

# Keycloak
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_MANAGEMENT_PORT=9001
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=a12345678
KEYCLOAK_REALM=constrsw
KEYCLOAK_CLIENT_ID=oauth
KEYCLOAK_CLIENT_SECRET=wsNXUxaupU9X6jCncsn3rOEy6PDt7oJO
KEYCLOAK_GRANT_TYPE=password
KEYCLOAK_TOKEN_ALGORITHM=RS256
KEYCLOAK_INTERNAL_PROTOCOL=http
KEYCLOAK_INTERNAL_HOST=keycloak
KEYCLOAK_INTERNAL_METRICS_PORT=9001
KEYCLOAK_INTERNAL_API_PORT=8080
KEYCLOAK_INTERNAL_CONSOLE_PORT=8080
KEYCLOAK_EXTERNAL_PROTOCOL=http
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_API_PORT=8081
KEYCLOAK_EXTERNAL_METRICS_PORT=9001
KEYCLOAK_EXTERNAL_CONSOLE_PORT=8081
# Literal URL — Compose does not reliably expand ${VAR} inside .env values.
# Internal Docker DNS hostname must match keycloak service/container name.
KEYCLOAK_SERVER_URL=http://keycloak:8080

# oauth
OAUTH_INTERNAL_PROTOCOL=http
# Must match docker-compose service/container name `oauth` (not legacy `auth`).
OAUTH_INTERNAL_HOST=oauth
OAUTH_INTERNAL_API_PORT=3001
OAUTH_INTERNAL_DEBUG_PORT=9464
OAUTH_INTERNAL_METRICS_PORT=9464
OAUTH_EXTERNAL_PROTOCOL=http
OAUTH_EXTERNAL_HOST=localhost
OAUTH_EXTERNAL_API_PORT=8181
OAUTH_EXTERNAL_DEBUG_PORT=8281
OAUTH_EXTERNAL_METRICS_PORT=8381
